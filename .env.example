# Firebase Configuration
# Firebase services are auto-configured via firebase-applet-config.json.

# Server Secrets (Server-only)
GEMINI_API_KEY=
SUPER_ADMIN_BOOTSTRAP_SECRET=

# Razorpay Payment Gateway Configuration (Server-only)
# Obtain from Razorpay Dashboard -> Account & Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

