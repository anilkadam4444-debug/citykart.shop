# Firebase Configuration
# Firebase services are auto-configured via firebase-applet-config.json.
# Optional Web Push VAPID Key from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Optional Firebase Admin Service Account JSON for server-side FCM push dispatch outside GCP/App Hosting
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server Secrets (Server-only)
GEMINI_API_KEY=
SUPER_ADMIN_BOOTSTRAP_SECRET=

# Razorpay Payment Gateway Configuration (Server-only)
# Obtain from Razorpay Dashboard -> Account & Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
