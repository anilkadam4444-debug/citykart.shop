# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# FIREBASE & CLOUD RUN ARCHITECTURE NOTES (NO SERVICE ACCOUNT KEY REQUIRED)
# ============================================================================
# Project ID: urbandirectintracity
# Client configuration is loaded from /firebase-applet-config.json.
#
# Privileged & Server-Side Operations (Zero-Key Architecture):
# 1. Server-Side Firebase ID Token Verification:
#    Verified cryptographically on the server using Application Default Credentials (ADC)
#    or Google's public X.509 certificates (securetoken@system.gserviceaccount.com).
#    No service account private key JSON is required.
# 2. Initial Super Admin Provisioning (+918329306616 -> role: "super_admin"):
#    Enforced on the backend via /api/admin/bootstrap using verified Firebase Phone Auth
#    ID tokens, server-signed HttpOnly HMAC session cookies (urbandirect_session),
#    and the Firestore /admins/{uid} collection protected by Zero-Trust firestore.rules.
# 3. Server-Side FCM Push Notifications:
#    Uses Cloud Run Service Identity / Application Default Credentials (ADC) when
#    deployed on Google Cloud, with automatic Firestore /sellerNotifications/{id}
#    real-time in-app notification delivery.
#
# Optional Environment Overrides (commented out so deployment does not require secrets):
# NEXT_PUBLIC_FIREBASE_WEB_PUSH_CERTIFICATE_KEY=""
# SUPER_ADMIN_BOOTSTRAP_SECRET=""
# OTP_HMAC_SECRET=""

# Razorpay Integration (Required for Seller Subscriptions)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
