rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.phone_number == '+918329306616' ||
        (request.auth.token.email == 'anilkadam4444@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.email == 'admin@citykart.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection Health Check Collection
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admins Registry
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Admin Authorizations
    match /adminAuthorizations/{phoneId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Sellers Collection
    match /sellers/{sellerId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Stores Collection
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Seller Notifications
    match /sellerNotifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Deleted Stores Tombstones
    match /deleted_stores/{storeId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if isSignedIn();
    }

    // FCM Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    // Merchant Subscriptions
    match /merchantSubscriptions/{subscriptionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Billing Transactions
    match /billingTransactions/{transactionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Featured Campaigns
    match /featuredCampaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Merchant Service Orders
    match /merchantServiceOrders/{orderId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Location Directory: Countries, Regions, Cities
    match /locationCountries/{countryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /locationRegions/{regionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /locationCities/{cityId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /locationImportRuns/{importId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /locationMissingRequests/{requestId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /locationRequests/{requestId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Platform Settings
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Partner Applications (both camelCase & snake_case path names)
    match /partnerApplications/{applicationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /partner_applications/{applicationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // City Partners & Allocations
    match /cityPartners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /cityPartnerAllocations/{cityId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /partnerSettlements/{settlementId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /partnerNotifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
