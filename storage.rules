rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && (
          request.auth.token.phone_number == '+918329306616'
          || request.auth.token.role == 'super_admin'
          || request.auth.token.super_admin == true
        );
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          isSuperAdmin()
          || request.auth.token.role == 'admin'
          || request.auth.token.admin == true
        );
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Publicly readable store & product media; writable only by owner or verified Admin/Super Admin
    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isAuthenticated() || isAdmin()) && isValidImageUpload();
      allow delete: if isAuthenticated() || isAdmin();
    }

    match /products/{sellerUid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || isAdmin() || (isAuthenticated() && request.auth.uid == sellerUid))
        && isValidImageUpload();
      allow delete: if isSuperAdmin() || isAdmin() || (isAuthenticated() && request.auth.uid == sellerUid);
    }

    // Default deny for all other Storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
